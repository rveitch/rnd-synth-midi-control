{
  "name": "rnd-synth-midi-control",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "probe:contrasts": ".scanner-venv/bin/python scripts/probeContrasts.py",
    "probe:transport": ".scanner-venv/bin/python scripts/probeTransport.py",
    "scan:seeds": ".scanner-venv/bin/python scripts/scanSeeds.py",
    "test": "vitest run",
    "test:scanner": ".scanner-venv/bin/python -m unittest scripts/testScanSeeds.py",
    "typecheck": "vue-tsc -b",
    "lint": "eslint ."
  },
  "dependencies": { "vue": "^3.5.18" },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.2.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "eslint": "^9.32.0",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.39.0",
    "vite": "^7.1.1",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.0.5"
  }
}
